# GMGN Auth
GMGN_API_KEY=your_gmgn_api_key
GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Wallet
WALLET_ADDRESS=your_solana_wallet_address

# Trading Parameters
TRADE_SIZE_SOL=0.1
MAX_CONCURRENT_POSITIONS=3
SCAN_INTERVAL_SEC=15
POSITION_CHECK_INTERVAL_SEC=10

# Strategy Thresholds
MIN_SCORE_TO_BUY=65
AI_CONFIDENCE_THRESHOLD=0.6

# Exit Parameters (all optional — if empty, AI controls that side)
# TRAILING_ACTIVATE_PCT and TRAILING_DRAWDOWN_PCT must be set together
TRAILING_ACTIVATE_PCT=
TRAILING_DRAWDOWN_PCT=
STOP_LOSS_PCT=
MAX_HOLD_DURATION_MINUTES=120

# Token Filters — Server-side
MIN_LIQUIDITY_USD=10000
MIN_HOLDER_COUNT=100
MAX_TOP_10_HOLDER_RATE=0.50
MAX_RUG_RATIO=0.30
MIN_TOKEN_AGE=5m
MAX_TOKEN_AGE=1440m
MIN_MARKETCAP=
MAX_MARKETCAP=
MIN_SMART_DEGEN_COUNT=0
MIN_RENOWNED_COUNT=0
MAX_INSIDER_RATIO=
MAX_CREATOR_BALANCE_RATE=

# Kline Signal Parameters
KLINE_RESOLUTION=5m
LOW_ZONE_MIN_MINUTES=10
LOW_ZONE_MAX_MINUTES=60
RECOVERY_VOLUME_LOOKBACK_MINUTES=15

# Execution
SLIPPAGE=0.15
AUTO_SLIPPAGE=false
ANTI_MEV=true

# Mode
DRY_RUN=true
