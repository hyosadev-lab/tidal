# GMGN Auth
GMGN_API_KEY=your_gmgn_api_key
GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Wallet
WALLET_ADDRESS=your_solana_wallet_address

# Trading Parameters
TRADE_SIZE_SOL=0.1
MAX_CONCURRENT_POSITIONS=3
SCAN_INTERVAL_SEC=15
POSITION_CHECK_INTERVAL_SEC=40

# Strategy Thresholds
MIN_SCORE_TO_BUY=60
AI_CONFIDENCE_THRESHOLD=0.60

# Weights for scoring components (must sum to 1.0)
WEIGHT_DIP=0.3
WEIGHT_MOMENTUM=0.3
WEIGHT_SMART_MONEY=0.4

# Exit Parameters (all optional — if empty, AI controls that side)
# TRAILING_ACTIVATE_PCT and TRAILING_DRAWDOWN_PCT must be set together
TRAILING_ACTIVATE_PCT=
TRAILING_DRAWDOWN_PCT=
STOP_LOSS_PCT=
MAX_HOLD_DURATION_MINUTES=120

# Token Filters — Server-side
# Liquidity & Size
MIN_LIQUIDITY_USD=              # minimal likuiditas yang masuk akal setelah graduate
MIN_MARKETCAP=                  # naik sedikit dari 13k
MAX_MARKETCAP=                  # fokus early post-grad (sweet spot 15k-65k)

# Age (sangat penting)
MIN_TOKEN_AGE=                  # hindari yang terlalu fresh (sniper/dev play)
MAX_TOKEN_AGE=                  # turunkan dari 180m → kurangi overcrowded token

# Holder & Distribution
MIN_HOLDER_COUNT=               # minimal holders yang menandakan minat organik
MAX_TOP_10_HOLDER_RATE=         # max 25% (semakin rendah semakin bagus)

# Risk & Rug Protection
MAX_RUG_RATIO=                  # sangat ketat
MAX_INSIDER_RATIO=              # turunkan dari 0.10
MAX_CREATOR_BALANCE_RATE=       # turunkan dari 0.11

# Smart Money & Social Proof
MIN_SMART_DEGEN_COUNT=          # minimal 2 smart degen
MIN_RENOWNED_COUNT=             # minimal 1 KOL/renowned (bisa naik ke 2 kalau terlalu banyak noise)

# Lainnya
MIN_TOTAL_FEE=                  # minimal fee yang sudah dibayar (tanda ada aktivitas)

# Kline Signal Parameters
KLINE_RESOLUTION=5m
LOW_ZONE_MIN_MINUTES=10
LOW_ZONE_MAX_MINUTES=60
RECOVERY_VOLUME_LOOKBACK_MINUTES=15

# Execution
SLIPPAGE=0.15
AUTO_SLIPPAGE=false
ANTI_MEV=true

# Mode
DRY_RUN=true
