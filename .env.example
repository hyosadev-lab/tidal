# GMGN Auth
GMGN_API_KEY=your_gmgn_api_key
GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3-5-haiku-20241022

# Wallet
WALLET_ADDRESS=your_solana_wallet_address

# Trading Parameters
TRADE_SIZE_SOL=0.1
MAX_CONCURRENT_POSITIONS=2          # turunkan dari 3 → lebih selektif, kurangi exposure
SCAN_INTERVAL_SEC=15
POSITION_CHECK_INTERVAL_SEC=40

# Strategy Thresholds
# MIN_SCORE_TO_BUY dinaikkan: composite harus cukup tinggi SETELAH smart money gate terpenuhi
MIN_SCORE_TO_BUY=68                 # dinaikkan dari 60
AI_CONFIDENCE_THRESHOLD=0.70        # dinaikkan dari 0.60 — AI harus lebih yakin sebelum BUY

# Composite Score Weights (must sum to 1.0)
# Smart money dinaikkan jadi dominant weight karena jadi primary signal
WEIGHT_DIP=0.20                     # turunkan dari 0.30 — dip saja tidak cukup tanpa SM
WEIGHT_MOMENTUM=0.25                # sama
WEIGHT_SMART_MONEY=0.55             # naik dari 0.40 — SM jadi primary driver composite

# Exit Parameters (all optional — if empty, AI controls that side)
# TRAILING_ACTIVATE_PCT dan TRAILING_DRAWDOWN_PCT harus diset bersama
TRAILING_ACTIVATE_PCT=
TRAILING_DRAWDOWN_PCT=
STOP_LOSS_PCT=                      # kosongkan → AI control exit sepenuhnya
MAX_HOLD_DURATION_MINUTES=90        # turunkan dari 120 → cut stale positions lebih cepat
AI_EVALUATION=true

# Kline Signal Parameters
KLINE_RESOLUTION=5m

# Execution
SLIPPAGE=0.15
AUTO_SLIPPAGE=false
ANTI_MEV=true

# Mode
DRY_RUN=true
