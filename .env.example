OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# GMGN OpenAPI — daftar di https://gmgn.ai/ai
# Cukup ini untuk semua route baca (scanning, token info, holders, kline, smart money).
GMGN_API_KEY=

# Kunci penandatangan request GMGN OpenAPI — BUKAN private key wallet.
# Hanya dipakai route bertanda tangan: swap, order, wallet holdings, follow-wallet.
# Format: PEM satu baris dengan \n, atau multiline dalam kutip ganda.
GMGN_PRIVATE_KEY=

# Catatan: `gmgn-cli` membaca kredensialnya sendiri dari ~/.config/gmgn/.env dan file
# itu menang atas nilai di sini. Dua variabel di atas untuk panggilan HTTP proses ini.

# Live mode di Solana: swap lewat Jupiter, ditandatangani proses ini sendiri.
# INI private key wallet (base58 64-byte seperti hasil export Phantom/GMGN, atau JSON array).
# Siapa pun yang bisa baca file ini bisa menguras wallet-nya — pakai hot wallet khusus, saldo kecil.
# Mengisi ini = persetujuan kamu untuk live trading otomatis di Solana; jalur ini TIDAK
# mengecek GMGN_ALLOW_AUTOMATED_TRADES.
# SOLANA_PRIVATE_KEY=
# Opsional: tanpa key, Jupiter dipakai keyless (30 request/menit). Daftar di https://developers.jup.ag/portal
# JUPITER_API_KEY=
# Opsional: RPC untuk baca saldo wallet. Default https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=

# dashboard (opsional)
PORT=3111
HOST=127.0.0.1

# Wajib kalau HOST bukan loopback (mis. 0.0.0.0 di VPS). Dashboard menampilkan halaman
# login; masukkan token ini, sesi disimpan 30 hari. Min. 32 karakter: `openssl rand -hex 32`.
# Tetap pasang HTTPS di depannya (Caddy/nginx) — tanpa TLS token ini lewat plaintext.
# DASHBOARD_TOKEN=

# HANYA set ini kalau kamu benar-benar mau live trading otomatis tanpa konfirmasi
# per-transaksi. Ini adalah persetujuan kamu — jangan set "buat jaga-jaga".
# Berlaku untuk chain yang swap lewat GMGN (BSC/Base/ETH/Robinhood); Solana pakai
# SOLANA_PRIVATE_KEY di atas.
# GMGN_ALLOW_AUTOMATED_TRADES=1
